{
  // Path mappings for `electrobun/*` come from the Hutch devkit projection.
  // Run `hutch electrobun prepare` if .hutch/devkit is missing.
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "electrobun.config.ts", "hutch.config.ts"],
  "exclude": ["node_modules", ".ref", ".hutch", "dist"]
}
